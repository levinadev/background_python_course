# Скопируйте в .env и поменяйте значения. Файл .env в git не попадает
FLOWER_PASSWORD=change-me
CELERY_TIMEZONE=Europe/Moscow
# Доля ответов 429 у учебной нейросети, 0 отключает сбои
AI_FAIL_RATE=0.3

# На сервере вместо Mailpit укажите свой почтовый сервис
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=secret
# SMTP_STARTTLS=1
# MAIL_FROM=noreply@example.com
